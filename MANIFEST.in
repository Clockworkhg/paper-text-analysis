include README.md
include CHANGELOG.md
include VERSION
include pytest.ini
include requirements.txt
include pyproject.toml

recursive-include assets *
recursive-include docs *.md
recursive-include tests *.py
recursive-include tools *.py *.json

exclude .gitignore
exclude .gitattributes
exclude *.spec

prune literature_md
prune literature_raw
prune ocr_output
prune output
prune outputs
prune projects
prune runtime
prune workspace
prune dist
prune build
prune .cache
prune .ocr_deps
prune .pytest_cache
prune .venv
