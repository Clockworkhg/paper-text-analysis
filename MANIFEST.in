include README.md
include CHANGELOG.md
include VERSION
include pytest.ini
include requirements.txt
include pyproject.toml

recursive-include assets *
recursive-include docs *.md
recursive-include tests *.py
recursive-include tools *.py *.json

exclude .gitignore
exclude .gitattributes

prune 文献
prune output
prune outputs
prune dist
prune build
prune .cache
prune .ocr_deps
